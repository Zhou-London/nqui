{
	"name": "@nqui/react",
	"version": "0.1.0",
	"description": "NQUI React components: an original Tailwind CSS v4 + React Aria component library for consoles, data warehouses, monitoring, and finance UI.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@internationalized/date": "catalog:",
		"@nqui/theme": "workspace:^",
		"@number-flow/react": "catalog:",
		"@tanstack/react-table": "catalog:",
		"@tanstack/react-virtual": "catalog:",
		"clsx": "catalog:",
		"lucide-react": "catalog:",
		"react-aria-components": "catalog:",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "catalog:"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.3.0"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tailwindcss": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"happy-dom": "catalog:",
		"@testing-library/react": "catalog:"
	}
}
