{
	"name": "nqui",
	"version": "0.1.0",
	"description": "NQUI: an original Tailwind CSS v4 + React Aria component library for consoles, data warehouses, monitoring, and finance UI, with charts and a SQL editor as sub-entries.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Zhou-London/nqui.git",
		"directory": "packages/nqui"
	},
	"homepage": "https://github.com/Zhou-London/nqui#readme",
	"bugs": {
		"url": "https://github.com/Zhou-London/nqui/issues"
	},
	"keywords": [
		"react",
		"tailwindcss",
		"react-aria",
		"components",
		"ui",
		"data-grid",
		"charts",
		"sql-editor",
		"finance",
		"dashboard"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"styles"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"style": "./styles/index.css",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./charts": {
			"types": "./dist/charts.d.ts",
			"default": "./dist/charts.js"
		},
		"./sql": {
			"types": "./dist/sql.d.ts",
			"default": "./dist/sql.js"
		},
		"./theme.css": {
			"style": "./styles/index.css",
			"default": "./styles/index.css"
		},
		"./tokens.css": "./styles/tokens.css",
		"./tailwind.css": "./styles/tailwind.css",
		"./nqui.css": "./dist/nqui.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown && tailwindcss -i build/full.css -o dist/nqui.css --minify",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "cp ../../README.md README.md",
		"postpack": "rm -f README.md"
	},
	"dependencies": {
		"@codemirror/autocomplete": "catalog:",
		"@codemirror/commands": "catalog:",
		"@codemirror/lang-sql": "catalog:",
		"@codemirror/language": "catalog:",
		"@codemirror/search": "catalog:",
		"@codemirror/state": "catalog:",
		"@codemirror/view": "catalog:",
		"@internationalized/date": "catalog:",
		"@lezer/highlight": "catalog:",
		"@number-flow/react": "catalog:",
		"@tanstack/react-table": "catalog:",
		"@tanstack/react-virtual": "catalog:",
		"clsx": "catalog:",
		"lightweight-charts": "catalog:",
		"lucide-react": "catalog:",
		"react-aria-components": "catalog:",
		"recharts": "catalog:",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "catalog:",
		"tailwindcss-react-aria-components": "catalog:"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.3.0"
	},
	"devDependencies": {
		"@tailwindcss/cli": "catalog:",
		"@testing-library/react": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"happy-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tailwindcss": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
