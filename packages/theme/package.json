{
	"name": "@nqui/theme",
	"version": "0.1.0",
	"description": "NQUI design tokens: CSS variables plus the Tailwind CSS v4 theme that maps them to utilities.",
	"license": "MIT",
	"type": "module",
	"sideEffects": true,
	"style": "./src/index.css",
	"files": [
		"src",
		"dist"
	],
	"exports": {
		".": {
			"style": "./src/index.css",
			"default": "./src/index.css"
		},
		"./tokens.css": "./src/tokens.css",
		"./tailwind.css": "./src/tailwind.css",
		"./nqui.css": "./dist/nqui.css"
	},
	"scripts": {
		"build": "echo \"@nqui/theme ships CSS sources; the prebuilt nqui.css is produced by the root build:css script\"",
		"typecheck": "echo \"no TypeScript in @nqui/theme\""
	},
	"dependencies": {
		"tailwindcss-react-aria-components": "catalog:"
	},
	"peerDependencies": {
		"tailwindcss": "^4.3.0"
	}
}
