{
	"name": "nqui",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build": "pnpm --filter nqui build",
		"dev": "pnpm --filter nqui-playground dev",
		"preview": "pnpm --filter nqui-playground build && pnpm --filter nqui-playground preview",
		"typecheck": "pnpm -r typecheck",
		"check": "biome check .",
		"fix": "biome check --write .",
		"test": "vitest run",
		"publint": "pnpm --filter nqui exec publint"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@testing-library/react": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"happy-dom": "catalog:",
		"publint": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
